# Navo API (server-side only — never exposed to the browser)
NAVO_API_URL=https://navoapi.viaspark.site/api/v1
# Same value as EXPO_PUBLIC_API_KEY in navo_app_frontend/.env (sent as the expo-api-key header)
NAVO_API_KEY=

# The navo_api needs WEB_APP_URL set to this site's public URL so Nomba payments
# return to /payment/complete. Locally: http://localhost:3000
